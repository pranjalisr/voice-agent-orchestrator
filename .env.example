# ─────────────────────────────────────────────────────────────────────────
#  VOX / ORCHESTRATOR  —  configuration
#
#  Copy this file to `.env` and fill in what you need.
#  EVERYTHING here is optional: with no .env at all, the whole system runs
#  in full mock mode (rule-based planner + simulated tools) so you can try
#  the barge-in loop offline, with zero API keys.
# ─────────────────────────────────────────────────────────────────────────

# ── LLM planner ──────────────────────────────────────────────────────────
# provider: mock | anthropic | openai | deepseek
#   mock      → rule-based planner, no network, no key (default)
#   anthropic → Claude   (default model: claude-sonnet-4-6)
#   openai    → GPT       (default model: gpt-4o)
#   deepseek  → DeepSeek  (default model: deepseek-chat)
# If you pick a real provider but leave LLM_API_KEY blank, it silently
# falls back to mock so the app still boots.
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional override; leave blank to use the provider default above.
LLM_MODEL=

# ── n8n backend ("the hands") ────────────────────────────────────────────
# Leave N8N_BASE_URL blank to run tools in MOCK mode (simulated latency,
# no real side effects). Set it to your n8n host to fire real webhooks.
#   e.g. https://n8n.example.com
N8N_BASE_URL=
# Webhook path prefix; each tool is called at {N8N_BASE_URL}{PREFIX}/{tool}
N8N_WEBHOOK_PREFIX=/webhook

# ── Timing knobs ─────────────────────────────────────────────────────────
# Simulated tool latency in mock mode (seconds). Higher = easier to barge in
# mid-call and watch the ledger mark an effect UNCERTAIN.
MOCK_TOOL_LATENCY=2.5
# How long the agent "speaks" a line (seconds per word, with a cap). These
# gate how much interruptible speaking time you get before tools run.
SPEAK_SECONDS_PER_WORD=0.30
SPEAK_SECONDS_CAP=6.0
